{
  "name": "avgst-4-site",
  "version": "0.1.0",
  "private": true,
  "description": "Авангард Строй 4.0 — публичный сайт. Next.js App Router.",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "index:site": "node scripts/index-site.mjs",
    "predev": "npm run images:prepare && npm run index:site",
    "prebuild": "npm run images:prepare && npm run index:site",
    "images:prepare": "node scripts/prepare-webp-assets.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "frames:build": "node scripts/build-manufacture-frames.mjs",
    "test:e2e": "playwright test",
    "diagnostics:release": "node scripts/run-browser-diagnostics.mjs local release",
    "diagnostics:production": "node scripts/run-browser-diagnostics.mjs production",
    "test:e2e:cookie": "playwright test e2e/cookie-consent.spec.ts"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.0",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-tabs": "^1.2.0",
    "@tabler/icons-react": "3.34.1",
    "@yandex/smart-captcha": "^2.9.1",
    "geist": "1.4.2",
    "next": "16.4.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.4.3",
    "sharp": "0.35.5",
    "typescript": "5.7.3"
  }
}
