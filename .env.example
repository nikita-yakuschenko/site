# Публичный адрес контура. Используется для канонических ссылок и sitemap.
NEXT_PUBLIC_SITE_URL=https://new.avgst.ru

# Серверное подключение каталога и форм. Секрет совпадает с CMS.
# Без ключа каталог CMS недоступен; заглушки не заменяют реальные записи.
CMS_PUBLIC_URL=https://cms.avgst.ru
CMS_SITE_API_KEY=

# AO-02: server-only; keep disabled until baseline preparation and the AO-03 UI rollout.
OPTIMIZATION_ENABLED=false
OPTIMIZATION_PREFERENCES_ENABLED=false
OPTIMIZATION_EVENTS_ENABLED=false
# Independent stable >=32-character secret, identical on site and CMS. Never NEXT_PUBLIC_.
OPTIMIZATION_PREFERENCES_SECRET=
OPTIMIZATION_CONTEXT_SECRET=

# Версия и коммит попадают в ответ /api/health. В Dokploy проставляются
# аргументами сборки, локально можно не задавать.
APP_VERSION=0.1.0
APP_COMMIT=local

# Появится вместе с PostgreSQL, задача AV4-9.
# DATABASE_URI=postgres://user:password@host:5432/avgst4

# Появится вместе с Payload CMS, задача AV4-10.
# PAYLOAD_SECRET=

# Ключ JavaScript API Яндекс.Карт для карты офиса в панели графика работы.
# Уходит в браузер вместе с загрузчиком карт — иначе JS API не работает,
# поэтому защита не в секретности, а в ограничении по HTTP Referer в
# кабинете Яндекса. Без ключа блок карты не показывается.
NEXT_PUBLIC_YANDEX_MAPS_KEY=

# Номер счётчика Яндекс.Метрики. Счётчик грузится сразу, не дожидаясь
# согласия на куки: иначе в статистику не попадают те, кто ушёл, не приняв
# баннер. Без номера счётчик не подключается вовсе.
NEXT_PUBLIC_YM_ID=
