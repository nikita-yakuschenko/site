# Публичный адрес контура. Используется для канонических ссылок и sitemap.
NEXT_PUBLIC_SITE_URL=https://new.avgst.ru

# Версия и коммит попадают в ответ /api/health. В Dokploy проставляются
# аргументами сборки, локально можно не задавать.
APP_VERSION=0.1.0
APP_COMMIT=local

# Появится вместе с PostgreSQL, задача AV4-9.
# DATABASE_URI=postgres://user:password@host:5432/avgst4

# Появится вместе с Payload CMS, задача AV4-10.
# PAYLOAD_SECRET=
