{
  "name": "avgst-cms",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "payload generate:importmap && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "payload": "payload",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "migrate": "payload migrate",
    "migrate:status": "payload migrate:status",
    "migrate:create": "payload migrate:create",
    "bootstrap": "tsx scripts/bootstrap.ts",
    "import:site": "tsx scripts/import-site.ts",
    "structure:complete": "tsx scripts/complete-page-structure.ts",
    "test": "tsx --test tests/*.test.ts tests/*.test.mjs",
    "test:integration": "tsx --test --test-force-exit tests/integration/*.test.ts"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/translations": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "@tabler/icons-react": "3.34.1",
    "@tailwindcss/postcss": "4.3.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "exceljs": "4.4.0",
    "geist": "1.4.2",
    "graphql": "16.11.0",
    "next": "16.4.0",
    "next-themes": "^0.4.6",
    "payload": "3.90.2",
    "radix-ui": "^1.8.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "recharts": "^3.8.0",
    "sharp": "0.35.5",
    "sonner": "^2.0.8",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.0",
    "tsx": "4.21.0",
    "typescript": "5.7.3"
  },
  "overrides": {
    "undici": "^7.29.1",
    "sonner": "$sonner"
  }
}
