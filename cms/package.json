{
  "name": "avgst-cms",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "payload generate:importmap && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "payload": "payload",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "migrate": "payload migrate",
    "migrate:status": "payload migrate:status",
    "migrate:create": "payload migrate:create",
    "bootstrap": "tsx scripts/bootstrap.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "tsx --test --test-force-exit tests/integration/*.test.ts"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/translations": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "graphql": "16.11.0",
    "next": "16.4.0",
    "payload": "3.90.2",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.0",
    "tsx": "4.21.0",
    "typescript": "5.7.3"
  },
  "overrides": {
    "undici": "^7.29.1"
  }
}
