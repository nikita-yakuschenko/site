# Separate CMS database; do not use the public site's environment file.
DATABASE_URL=
PAYLOAD_SECRET=
CMS_PUBLIC_URL=http://localhost:3001
SITE_PUBLIC_URL=http://localhost:3000
CMS_SITE_API_KEY=
CMS_MEDIA_DIR=./media
# Production requires a mounted persistent directory before uploads are enabled.
CMS_MEDIA_PERSISTENT=false
# NODE_ENV is set by Next / Docker. Production uses https://cms.avgst.ru.
