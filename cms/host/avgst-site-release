#!/usr/bin/env python3
"""Root-owned release entry point; the runner supplies only image and revision."""
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request


def run(*args):
    return subprocess.check_output(args, text=True).strip()


def matches_readiness(responses, revision):
    health, ready = responses['health'], responses['ready']
    return health.get('status') == 'ok' and ready.get('status') == 'ready' and health.get('commit') == revision and bool(health.get('buildId')) and ready.get('buildId') == health['buildId']


def main():
    import fcntl

    if os.geteuid() != 0 or len(sys.argv) != 3:
        raise RuntimeError('Root and exactly two arguments required')
    image, revision = sys.argv[1:]
    if not re.fullmatch(r'ghcr\.io/nikita-yakuschenko/avgst-site@sha256:[a-f0-9]{64}', image) or not re.fullmatch(r'[a-f0-9]{40}', revision):
        raise RuntimeError('Invalid release identity')
    config = {}
    for line in Path('/etc/avgst/site-release.env').read_text().splitlines():
        if line and not line.startswith('#'):
            key, value = line.split('=', 1)
            config[key] = value
    lock = open('/var/lib/avgst/site-release.lock', 'a')
    fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    subprocess.run(['docker', 'pull', image], check=True, stdout=subprocess.DEVNULL)
    details = json.loads(run('docker', 'image', 'inspect', image))[0]
    labels = details.get('Config', {}).get('Labels', {}) or {}
    if labels.get('org.opencontainers.image.source') != 'https://github.com/nikita-yakuschenko/site' or labels.get('org.opencontainers.image.revision') != revision:
        raise RuntimeError('Image source/revision mismatch')

    def api(method, body=None):
        url = config['DOKPLOY_API_URL'].rstrip('/') + '/' + method
        request = urllib.request.Request(url, data=json.dumps(body).encode() if body is not None else None, headers={
            'Content-Type': 'application/json', 'x-api-key': config['DOKPLOY_API_KEY'],
        })
        with urllib.request.urlopen(request, timeout=40) as response:
            return json.load(response)

    app_id = config['DOKPLOY_APPLICATION_ID']
    query = 'application.one?' + urllib.parse.urlencode({'applicationId': app_id})
    previous = api(query)
    if previous.get('command') or previous.get('args'):
        raise RuntimeError('Unexpected saved container command')

    def deploy(target, title):
        api('application.saveDockerProvider', {'applicationId': app_id, 'dockerImage': target, 'username': None, 'password': None, 'registryUrl': 'ghcr.io'})
        api('application.deploy', {'applicationId': app_id, 'title': title})

    def ready():
        saved = api(query)
        if saved.get('dockerImage') != image:
            return False
        containers = run('docker', 'ps', '-q', '--filter', 'label=com.docker.swarm.service.name=' + config['SITE_SWARM_SERVICE']).splitlines()
        if not containers or any(run('docker', 'inspect', container, '--format', '{{.Image}}') != details['Id'] for container in containers):
            return False
        responses = {}
        for endpoint, status in [('health', 'ok'), ('ready', 'ready')]:
            with urllib.request.urlopen(config['SITE_PUBLIC_ORIGIN'] + '/api/' + endpoint, timeout=15) as response:
                result = json.load(response)
            responses[endpoint] = result
        return matches_readiness(responses, revision)

    deploy(image, 'Сайт ' + revision[:12])
    for _ in range(60):
        try:
            if ready():
                print('Сайт обслуживает ' + revision + '; Dokploy и контейнер согласованы.')
                return
        except (OSError, ValueError, urllib.error.URLError, subprocess.CalledProcessError):
            pass
        time.sleep(5)
    if previous.get('dockerImage') and previous['dockerImage'] != image:
        deploy(previous['dockerImage'], 'Откат сайта после неуспешной проверки')
    raise RuntimeError('Release did not become ready')


if __name__ == '__main__':
    try:
        main()
    except Exception as error:
        # Never print responses or URLs: infrastructure credentials stay on the host.
        print('Выпуск сайта остановлен: ' + type(error).__name__, file=sys.stderr)
        sys.exit(1)
